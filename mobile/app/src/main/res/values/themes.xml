<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Chaomi" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/chaomi_accent</item>
        <item name="colorPrimaryVariant">@color/chaomi_accent_2</item>
        <item name="colorOnPrimary">#ffffff</item>
        <item name="colorSecondary">@color/chaomi_gold</item>
        <item name="colorOnSecondary">#1c2128</item>
        <item name="android:colorBackground">@color/chaomi_bg</item>
        <item name="colorSurface">@color/chaomi_surface</item>
        <item name="colorOnSurface">@color/chaomi_text</item>
        <item name="android:textColor">@color/chaomi_text</item>
        <item name="android:textColorPrimary">@color/chaomi_text</item>
        <item name="android:textColorSecondary">@color/chaomi_text_dim</item>
        <item name="android:statusBarColor">@color/chaomi_bg</item>
        <item name="android:navigationBarColor">@color/chaomi_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="bottomSheetDialogTheme">@style/Theme.Chaomi.BottomSheet</item>
    </style>

    <style name="Theme.Chaomi.BottomSheet" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="android:colorBackground">@color/chaomi_surface</item>
        <item name="colorSurface">@color/chaomi_surface</item>
        <item name="android:statusBarColor">@color/chaomi_bg</item>
    </style>

    <!-- 阅读页：无状态栏遮挡的沉浸式 -->
    <style name="Theme.Chaomi.Reader" parent="Theme.Chaomi">
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>
</resources>
