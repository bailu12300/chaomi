<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@color/chaomi_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/chaomi_accent"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/bMoveUp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:text="↑"
            android:textColor="@color/chaomi_text_dim"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/bMoveDown"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:text="↓"
            android:textColor="@color/chaomi_text_dim"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/bDel"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/chaomi_down"
            android:textSize="17sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/bText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/chaomi_surface_2"
        android:gravity="top"
        android:minLines="2"
        android:padding="10dp"
        android:textColor="@color/chaomi_text"
        android:textColorHint="@color/chaomi_text_dim"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/bImage"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="6dp"
        android:background="@color/chaomi_surface_2"
        android:scaleType="centerCrop"
        android:visibility="gone" />
</LinearLayout>
