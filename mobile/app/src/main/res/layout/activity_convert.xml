<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chaomi_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/chaomi_bg"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/chaomi_text"
        app:title="万能格式转换"
        app:titleTextColor="@color/chaomi_text" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/cvCaps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="加载中…"
                android:textColor="@color/chaomi_text_dim"
                android:textSize="11.5sp" />

            <!-- tab -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/chaomi_surface_2"
                android:orientation="horizontal"
                android:padding="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cvTabData"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="数据格式"
                    android:textColor="@color/chaomi_accent"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cvTabCodec"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="编码工具"
                    android:textColor="@color/chaomi_text_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 数据格式 -->
            <LinearLayout
                android:id="@+id/cvPanelData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/chaomi_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/chaomi_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="源"
                                android:textColor="@color/chaomi_text_dim"
                                android:textSize="12sp" />

                            <Spinner
                                android:id="@+id/cvFrom"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="→"
                                android:textColor="@color/chaomi_text_dim"
                                android:textSize="14sp" />

                            <Spinner
                                android:id="@+id/cvTo"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/cvIn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@color/chaomi_surface_2"
                            android:gravity="top|start"
                            android:hint="粘贴源数据，例如：&#10;[{&quot;name&quot;:&quot;张三&quot;,&quot;age&quot;:28}]"
                            android:inputType="textMultiLine"
                            android:minLines="6"
                            android:padding="12dp"
                            android:textColor="@color/chaomi_text"
                            android:textColorHint="@color/chaomi_text_dim"
                            android:textSize="12.5sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cvGo"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="10dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="转换"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/cvInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/chaomi_text_dim"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/cvOut"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@color/chaomi_surface_2"
                            android:gravity="top|start"
                            android:hint="转换结果"
                            android:inputType="textMultiLine"
                            android:minLines="6"
                            android:padding="12dp"
                            android:textColor="@color/chaomi_text"
                            android:textColorHint="@color/chaomi_text_dim"
                            android:textSize="12.5sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cvCopy"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="复制结果"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 编码工具 -->
            <LinearLayout
                android:id="@+id/cvPanelCodec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/chaomi_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/chaomi_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <Spinner
                            android:id="@+id/cvOp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <EditText
                            android:id="@+id/cvCodecIn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@color/chaomi_surface_2"
                            android:gravity="top|start"
                            android:hint="输入内容"
                            android:inputType="textMultiLine"
                            android:minLines="5"
                            android:padding="12dp"
                            android:textColor="@color/chaomi_text"
                            android:textColorHint="@color/chaomi_text_dim"
                            android:textSize="12.5sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cvCodecGo"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="10dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="执行"
                            android:textSize="13.5sp" />

                        <EditText
                            android:id="@+id/cvCodecOut"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@color/chaomi_surface_2"
                            android:gravity="top|start"
                            android:hint="结果"
                            android:inputType="textMultiLine"
                            android:minLines="5"
                            android:padding="12dp"
                            android:textColor="@color/chaomi_text"
                            android:textColorHint="@color/chaomi_text_dim"
                            android:textSize="12.5sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/cvCopy2"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="复制结果"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="4dp"
                android:text="图片格式转换（PNG/JPEG/GIF/BMP/WebP）请在网页端操作：浏览器可直接预览与下载大文件，体验更好。"
                android:textColor="@color/chaomi_text_dim"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
