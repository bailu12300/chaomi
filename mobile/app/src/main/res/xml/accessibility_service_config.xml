<?xml version="1.0" encoding="utf-8"?>
<!--
  无障碍服务配置。
  关键项说明：
  - canRetrieveWindowContent：读取节点树（找「跳过」按钮的前提）
  - canPerformGestures：允许 dispatchGesture 模拟点击。
    ★ 很多开屏广告是 SurfaceView/自绘控件，只有手势能点中，
      缺这一项 performAction 会一直失败 → 表现为"跳不过去"
  - flagRetrieveInteractiveWindows：拿多窗口，开屏广告常在独立 overlay 里
  - flagIncludeNotImportantViews：部分 App 把「跳过」标记为 not important
  - notificationTimeout 50ms：开屏广告只显示 3-5 秒，必须尽快响应
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewClicked"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:description="@string/ad_skip_desc"
    android:notificationTimeout="50"
    android:settingsActivity="com.chaomi.app.MainActivity" />
